APP_ENV=development
HTTP_PORT=8080
DATABASE_URL=postgres://payment:payment@127.0.0.1:5433/payment?sslmode=disable

# Copy only a TEST-mode secret key from the Xendit dashboard.
XENDIT_SECRET_KEY=xnd_development_replace_with_test_key
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_WEBHOOK_TOKEN=replace_with_test_callback_token
ADMIN_API_TOKEN=replace_with_a_random_secret_of_at_least_32_characters
ADMIN_API_ACTOR=local-admin-api

# Optional test settings; test DB names must end in _test.
PAYMENT_TEST_DATABASE=payment_service_test
PAYMENT_SANDBOX_DATABASE=payment_service_sandbox_test
PAYMENT_SANDBOX_PORT=8091

ORDER_DATABASE_URL=postgres://payment:payment@localhost:5433/orderdb?sslmode=disable
ORDER_HTTP_PORT=8181
ORDER_SERVICE_TOKEN=a57c505c6b859f39e2606ab7da808508cc1fa04ecd1d370d487b86c3683f0ec1
# TEST_DATABASE_URL=postgres://payment:payment@127.0.0.1:5433/payment_service_test?sslmode=disable
# SANDBOX_DATABASE_URL=postgres://payment:payment@127.0.0.1:5433/payment_service_sandbox_test?sslmode=disable
# PAYMENT_TEST_REPORT_DIR=artifacts/payment-tests
