# SANDBOX_CALLBACK_CONFIGURED=1
# Set to 1 to verify an existing API instead of starting another process.
# SANDBOX_REUSE_API=1
PAYMENT_INTERNAL_TOKEN=your-long-random-internal-service-token
PAYMENT_SERVICE_URL=http://127.0.0.1:8080

CUSTOMER_JWT_SECRET=use-a-long-random-hs256-secret
CUSTOMER_JWT_ISSUER=order-service-dev
CUSTOMER_JWT_AUDIENCE=order-customer